# ==============================================================================
# userx Public Environment Variables
# (Read from Cloudflare Worker Runtime Variables OR Build Variables / local .env)
# ==============================================================================

# [Required in production when PUBLIC_RELAY_HTTP_URL is unset]
# Relay Iroh EndpointId (or full EndpointAddr JSON, or comma-separated list of EndpointIds).
# Grab from `araliya-net-relay` startup logs (`endpoint_id`) or `curl -s http://127.0.0.1:8080/status`.
PUBLIC_RELAY_ENDPOINT_ID=

# [Recommended in production]
# Relay 32-byte Ed25519 root public key (64-char hex or base64url) from `root_pubkey` in GET /status.
# Used client-side to badge root-authored onboarding questions as `@genesis`.
PUBLIC_ROOT_PUBKEY=

# [Optional — leave empty in production until an HTTP relay/proxy is hosted]
# Explicit HTTP relay base URL or proxy path. When set, HTTP `/status` takes precedence
# over `PUBLIC_RELAY_ENDPOINT_ID` (with Iroh fallback if HTTP fails).
# In local `vite dev`, defaults automatically to `/relay` (-> http://127.0.0.1:8080).
PUBLIC_RELAY_HTTP_URL=

# [Optional — leave empty when using default public n0 Iroh relays]
# Comma-separated custom Iroh/DERP relay URLs (required only if the relay runs with `--iroh-relay-url`).
PUBLIC_RELAY_URLS=

# [Optional — defaults to 72 hours (259200000 ms); set e.g. 30000 for testing expiry]
# Provisional waiting window TTL in milliseconds before an unapproved peer vouch request expires.
PUBLIC_VOUCH_REQUEST_TTL_MS=
